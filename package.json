{
  "name": "cyoda-dev-console",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm --filter './apps/**' --filter './packages/**' -r build",
    "test": "pnpm --filter './apps/**' --filter './packages/**' -r test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter './apps/**' --filter './packages/**' -r typecheck",
    "format": "prettier --write .",
    "tauri:dev": "pnpm --filter dev-console tauri:dev",
    "tauri:build": "pnpm --filter dev-console tauri:build"
  },
  "pnpm": {
    "overrides": {
      "@cyoda/workflow-core": "file:../cyoda-workflow-editor/packages/workflow-core",
      "@cyoda/workflow-graph": "file:../cyoda-workflow-editor/packages/workflow-graph",
      "@cyoda/workflow-layout": "file:../cyoda-workflow-editor/packages/workflow-layout",
      "@cyoda/workflow-monaco": "file:../cyoda-workflow-editor/packages/workflow-monaco",
      "@cyoda/workflow-react": "file:../cyoda-workflow-editor/packages/workflow-react",
      "@cyoda/workflow-viewer": "file:../cyoda-workflow-editor/packages/workflow-viewer",
      "immer": "11.1.8",
      "uuid": "14.0.0",
      "zod": "4.4.3",
      "elkjs": "0.11.1",
      "jsonc-parser": "3.3.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
