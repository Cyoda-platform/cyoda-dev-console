{
  "name": "cyoda-dev-console",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm --filter './apps/**' --filter './packages/**' -r build",
    "test": "pnpm --filter './apps/**' --filter './packages/**' -r test",
    "lint": "eslint .",
    "typecheck": "pnpm --filter './apps/**' --filter './packages/**' -r typecheck",
    "format": "prettier --write .",
    "tauri:dev": "pnpm --filter dev-console tauri:dev",
    "tauri:build": "pnpm --filter dev-console tauri:build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
